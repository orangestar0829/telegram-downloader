# Get api_id and api_hash from https://my.telegram.org
# (log in -> API development tools)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Optional. Example: +8613800138000
TELEGRAM_PHONE=

# Where files are saved
DOWNLOAD_DIR=./downloads

# Optional SOCKS5 endpoint (e.g. Karing local SOCKS port).
# Leave host empty for direct/TUN routing.
SOCKS5_HOST=
SOCKS5_PORT=
SOCKS5_USERNAME=
SOCKS5_PASSWORD=

# Telegram media downloads: 1-8 concurrent files, 0-5 retries.
MEDIA_CONCURRENCY=3
MEDIA_RETRIES=2
CHUNK_CONCURRENCY=1
